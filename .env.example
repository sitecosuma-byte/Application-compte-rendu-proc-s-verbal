# ---------------------------------------------------------------
# Clés API (côté serveur uniquement — ne jamais préfixer NEXT_PUBLIC_)
# Copiez ce fichier en .env.local puis renseignez au moins une clé.
# ---------------------------------------------------------------

# Transcription Whisper (OpenAI) et/ou Groq (whisper-large-v3, très rapide)
OPENAI_API_KEY=
GROQ_API_KEY=

# Rédaction du PV par Claude (Anthropic)
ANTHROPIC_API_KEY=

# Modèles (facultatif — valeurs par défaut indiquées)
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# OPENAI_CHAT_MODEL=gpt-4.1
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Mettre à "false" pour refuser les clés saisies dans l'interface
# (recommandé si l'application est publique et que vous fournissez vos propres clés).
# ALLOW_CLIENT_KEYS=true
